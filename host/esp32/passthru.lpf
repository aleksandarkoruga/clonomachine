# ULX3S v3.1.6+ pinout (emard/ulx3s doc/constraints/prototype/ulx3s_v316.lpf)
LOCATE COMP "ftdi_txd" SITE "M1"; IOBUF PORT "ftdi_txd" IO_TYPE=LVCMOS33;
LOCATE COMP "ftdi_rxd" SITE "L4"; IOBUF PORT "ftdi_rxd" IO_TYPE=LVCMOS33;
LOCATE COMP "ftdi_ndtr" SITE "N1"; IOBUF PORT "ftdi_ndtr" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "ftdi_nrts" SITE "M3"; IOBUF PORT "ftdi_nrts" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "wifi_txd" SITE "K4"; IOBUF PORT "wifi_txd" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "wifi_rxd" SITE "K3"; IOBUF PORT "wifi_rxd" IO_TYPE=LVCMOS33;
LOCATE COMP "wifi_en" SITE "J5"; IOBUF PORT "wifi_en" IO_TYPE=LVCMOS33;
LOCATE COMP "wifi_gpio0" SITE "F1"; IOBUF PORT "wifi_gpio0" IO_TYPE=LVCMOS33;
LOCATE COMP "sd_d0" SITE "J3"; IOBUF PORT "sd_d0" IO_TYPE=LVCMOS33 PULLMODE=UP;
LOCATE COMP "led[0]" SITE "B2"; LOCATE COMP "led[1]" SITE "C2"; LOCATE COMP "led[2]" SITE "C1"; LOCATE COMP "led[3]" SITE "D2";
LOCATE COMP "led[4]" SITE "D1"; LOCATE COMP "led[5]" SITE "E2"; LOCATE COMP "led[6]" SITE "E1"; LOCATE COMP "led[7]" SITE "H3";
IOBUF PORT "led[0]" IO_TYPE=LVCMOS33; IOBUF PORT "led[1]" IO_TYPE=LVCMOS33; IOBUF PORT "led[2]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[3]" IO_TYPE=LVCMOS33; IOBUF PORT "led[4]" IO_TYPE=LVCMOS33; IOBUF PORT "led[5]" IO_TYPE=LVCMOS33;
IOBUF PORT "led[6]" IO_TYPE=LVCMOS33; IOBUF PORT "led[7]" IO_TYPE=LVCMOS33;
